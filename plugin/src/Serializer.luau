-- Instances -> nodes -> one Luau module source per instance.
-- One file per instance keeps git diffs small and lets two people edit different parts of a
-- folder without conflicts.
local CollectionService = game:GetService("CollectionService")
local SerializationService = game:GetService("SerializationService")

local Codec = require(script.Parent.Codec)
local Util = require(script.Parent.Util)

local quote = Codec.quote

local Serializer = {}

-- Unions can't be rebuilt from properties, so their geometry is kept as an opaque .rbxm blob.
function Serializer.blobOf(inst: Instance): { string }
	local copy = inst:Clone()
	copy:ClearAllChildren()
	local buf = SerializationService:SerializeInstancesAsync({ copy })
	copy:Destroy()
	local b64 = Util.base64Encode(buf)
	local lines = {}
	for i = 1, #b64, 120 do
		table.insert(lines, b64:sub(i, i + 119))
	end
	return lines
end

-- assign = true gives instances without an id a permanent one (used when saving a snapshot).
-- assign = false only reads, so it is safe to run in the background; unsaved instances get
-- temporary ids and show up as "new".
function Serializer.collect(root: Instance, assign: boolean, yieldEvery: number?)
	local list = { root }
	for _, d in root:GetDescendants() do
		table.insert(list, d)
	end

	local ids, seen, temp = {}, {}, 0
	for _, inst in list do
		local id = inst:GetAttribute(Util.ID_ATTR)
		if type(id) ~= "string" or id == "" or seen[id] then
			if assign then
				repeat
					id = Util.newId()
				until not seen[id]
				inst:SetAttribute(Util.ID_ATTR, id)
			else
				temp += 1
				id = "new-" .. temp
			end
		end
		seen[id] = true
		ids[inst] = id
	end

	local function refId(target: Instance): string?
		return ids[target]
	end

	local nodes = table.create(#list)
	for i, inst in list do
		local node = {
			inst = inst,
			id = ids[inst],
			parentId = if i == 1 then nil else ids[inst.Parent],
			class = inst.ClassName,
			name = inst.Name,
			props = {},
			attrs = {},
			tags = {},
		}

		if i == 1 then
			local location = {}
			local p = inst.Parent
			while p and p ~= game do
				table.insert(location, 1, p.Name)
				p = p.Parent
			end
			node.location = location
		end

		local info = Codec.classInfo(inst.ClassName)
		for _, prop in info.props do
			local ok, value = pcall(function()
				return (inst :: any)[prop]
			end)
			if ok then
				local enc = Codec.encode(value, refId)
				if enc and enc ~= info.defaultEnc[prop] then
					node.props[prop] = enc
				end
			end
		end

		for k, v in inst:GetAttributes() do
			if k ~= Util.ID_ATTR and k ~= Util.PKG_ATTR then
				local enc = Codec.encode(v)
				if enc then
					node.attrs[k] = enc
				end
			end
		end

		for _, tag in CollectionService:GetTags(inst) do
			if tag ~= Util.ROOT_TAG then
				table.insert(node.tags, tag)
			end
		end
		table.sort(node.tags)

		if inst:IsA("LuaSourceContainer") then
			node.source = (inst :: any).Source
		end

		if inst:IsA("PartOperation") then
			local ok, lines = pcall(Serializer.blobOf, inst)
			if ok then
				node.blob = lines
			end
		end

		nodes[i] = node
		if yieldEvery and i % yieldEvery == 0 then
			task.wait()
		end
	end

	return nodes
end

local function sortedKeys(t: { [string]: any }): { string }
	local keys = {}
	for k in t do
		table.insert(keys, k)
	end
	table.sort(keys)
	return keys
end

-- Deterministic text for one node. Same input must always give the same text, otherwise
-- git sees changes that aren't there.
function Serializer.render(node): string
	local out = {
		"-- Asset Versioning snapshot (generated by the Studio plugin). Change things in Studio, not here.",
		"return {",
		"\tid = " .. quote(node.id) .. ",",
	}
	local function add(line: string)
		table.insert(out, line)
	end

	if node.parentId then
		add("\tparent = " .. quote(node.parentId) .. ",")
	else
		local parts = {}
		for _, name in node.location or {} do
			table.insert(parts, quote(name))
		end
		add("\tlocation = { " .. table.concat(parts, ", ") .. " },")
	end
	add("\tclass = " .. quote(node.class) .. ",")
	add("\tname = " .. quote(node.name) .. ",")

	local propKeys = sortedKeys(node.props)
	if #propKeys > 0 then
		add("\tprops = {")
		for _, k in propKeys do
			add("\t\t" .. k .. " = " .. node.props[k] .. ",")
		end
		add("\t},")
	end

	local attrKeys = sortedKeys(node.attrs)
	if #attrKeys > 0 then
		add("\tattributes = {")
		for _, k in attrKeys do
			add("\t\t[" .. quote(k) .. "] = " .. node.attrs[k] .. ",")
		end
		add("\t},")
	end

	if #node.tags > 0 then
		local parts = {}
		for _, tag in node.tags do
			table.insert(parts, quote(tag))
		end
		add("\ttags = { " .. table.concat(parts, ", ") .. " },")
	end

	if node.source then
		local level = 2
		while node.source:find("]" .. string.rep("=", level) .. "]", 1, true) do
			level += 1
		end
		local eq = string.rep("=", level)
		add("\tsource = [" .. eq .. "[\n" .. node.source .. "]" .. eq .. "],")
	end

	if node.blob then
		add("\tblob = {")
		for _, line in node.blob do
			add("\t\t" .. quote(line) .. ",")
		end
		add("\t},")
	end

	add("}")
	return table.concat(out, "\n") .. "\n"
end

return Serializer
